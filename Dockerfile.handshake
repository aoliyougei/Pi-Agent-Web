FROM registry.aoliyougei.com/library/node:22-alpine AS builder
WORKDIR /build/web
RUN apk add --no-cache git python3 make g++
COPY package.json package-lock.json ./
COPY packages/agent-contract/package.json packages/agent-contract/package.json
COPY packages/pi-web-agent-server/package.json packages/pi-web-agent-server/package.json
RUN npm ci --ignore-scripts
COPY . .
RUN npm --workspace @aoliyougei/pi-agent-contract run build && \
    npm --workspace @aoliyougei/pi-web-agent-server run build && \
    npm run build && npm prune --omit=dev --ignore-scripts

FROM registry.aoliyougei.com/library/node:22-alpine AS runtime
LABEL io.pi-agent-web.version="0.1.0" io.pi-agent.release-ready="false"
ENV HOME=/home/node PORT=30141 PI_WEB_HOSTNAME=0.0.0.0 PI_WEB_NO_OPEN=1
RUN apk add --no-cache curl && mkdir -p /opt/pi-agent-web && chown -R node:node /opt/pi-agent-web
COPY --from=builder --chown=node:node /build/web /opt/pi-agent-web
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY pi-agent-web-healthcheck /usr/local/bin/pi-agent-web-healthcheck
RUN chmod 0755 /usr/local/bin/docker-entrypoint.sh /usr/local/bin/pi-agent-web-healthcheck && \
    ln -s /opt/pi-agent-web/bin/pi-web.js /usr/local/bin/pi-web
USER node
WORKDIR /opt/pi-agent-web
EXPOSE 30141
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD ["pi-agent-web-healthcheck"]
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["pi-web"]
